package pages

import (
	"github.com/druarnfield/cleaning-scheduler/internal/auth"
	"github.com/druarnfield/cleaning-scheduler/internal/templates/layout"
)

templ ImportPage(user *auth.User) {
	@layout.Base("Import CSV", user) {
		<div class="flex justify-center items-center min-h-[60vh] px-4">
			<div class="card w-full max-w-96 bg-base-100 shadow-xl">
				<div class="card-body">
					<h2 class="card-title text-2xl mb-4">Import CSV</h2>
					<p class="text-base-content/60 mb-4">Upload a CSV file with the following columns: Task, Category, Frequency, Assigned To, Estimated Mins</p>
					<form method="POST" action="/import" enctype="multipart/form-data">
						<div class="form-control mb-6">
							<label class="label">
								<span class="label-text">Select CSV File</span>
							</label>
							<input type="file" name="csvfile" accept=".csv" class="file-input file-input-bordered" required/>
						</div>
						<button type="submit" class="btn btn-primary w-full">Import Tasks</button>
					</form>
					<div class="alert alert-warning mt-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
						</svg>
						<span>This will replace all existing tasks!</span>
					</div>
				</div>
			</div>
		</div>
	}
}