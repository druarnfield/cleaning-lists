package pages

import (
	"github.com/druarnfield/cleaning-scheduler/internal/auth"
	"github.com/druarnfield/cleaning-scheduler/internal/database/sqlc"
	"github.com/druarnfield/cleaning-scheduler/internal/templates/layout"
	"strconv"
)

type MealsPageData struct {
	Meals []sqlc.Meal
}

templ MealsPage(user *auth.User, data MealsPageData) {
	@layout.Base("Meals Management", user) {
		<div class="space-y-6">
			<div class="flex justify-between items-center">
				<h1 class="text-3xl font-bold">Meals Management</h1>
				<button class="btn btn-primary" onclick="document.getElementById('add_meal_modal').showModal()">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
					</svg>
					Add Meal
				</button>
			</div>

			<div class="card bg-base-100 shadow-xl">
				<div class="card-body">
					if len(data.Meals) == 0 {
						<div class="text-center py-12">
							<p class="text-base-content/60">No meals defined yet.</p>
							<p class="text-sm text-base-content/40">Click "Add Meal" to get started.</p>
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table table-zebra">
								<thead>
									<tr>
										<th>Meal Name</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									for _, meal := range data.Meals {
										@MealRow(meal)
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Add Meal Modal -->
		<dialog id="add_meal_modal" class="modal modal-bottom sm:modal-middle">
			<div class="modal-box">
				<h3 class="font-bold text-lg">Add Meal</h3>
				<form method="POST" action="/meals">
					<div class="form-control">
						<label class="label"><span class="label-text">Meal Name</span></label>
						<input type="text" name="name" class="input input-bordered" placeholder="e.g., Monday Dinner, Pasta Night" required/>
					</div>
					<div class="modal-action">
						<button type="button" class="btn" onclick="document.getElementById('add_meal_modal').close()">Cancel</button>
						<button type="submit" class="btn btn-primary">Add Meal</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>

		<!-- Edit Meal Modal -->
		<dialog id="edit_meal_modal" class="modal modal-bottom sm:modal-middle">
			<div class="modal-box">
				<h3 class="font-bold text-lg">Edit Meal</h3>
				<form id="edit-meal-form" hx-post="#" hx-swap="outerHTML" hx-target="#meal-row">
					<input type="hidden" id="edit-meal-id" name="id"/>
					<div class="form-control">
						<label class="label"><span class="label-text">Meal Name</span></label>
						<input type="text" id="edit-meal-name" name="name" class="input input-bordered" required/>
					</div>
					<div class="modal-action">
						<button type="button" class="btn" onclick="document.getElementById('edit_meal_modal').close()">Cancel</button>
						<button type="submit" class="btn btn-primary">Update Meal</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>

		<script>
			function editMeal(mealId, mealName) {
				// Set form action
				const form = document.getElementById('edit-meal-form');
				form.setAttribute('hx-post', `/meals/${mealId}`);
				form.setAttribute('hx-target', `#meal-${mealId}`);

				// Populate form fields
				document.getElementById('edit-meal-id').value = mealId;
				document.getElementById('edit-meal-name').value = mealName;

				// Re-process HTMX attributes
				htmx.process(form);

				// Show the modal
				document.getElementById('edit_meal_modal').showModal();
			}

			// Handle edit button clicks
			document.addEventListener('click', (e) => {
				if (e.target.classList.contains('edit-meal-btn')) {
					e.target.click();
				}
			});

			// Close modal after successful update
			document.body.addEventListener('htmx:afterSwap', function(evt) {
				if (evt.detail.target.id && evt.detail.target.id.startsWith('meal-')) {
					// Close the edit modal if it's open
					const modal = document.getElementById('edit_meal_modal');
					if (modal && modal.open) {
						modal.close();
					}
				}
			});
		</script>
	}
}

templ MealRow(meal sqlc.Meal) {
	<tr id={ "meal-" + strconv.FormatInt(meal.ID, 10) }>
		<td>{ meal.Name }</td>
		<td>
			<div class="flex gap-2">
				<button
					class="btn btn-xs btn-ghost edit-meal-btn"
					onclick={ templ.ComponentScript{Call: "editMeal(" + strconv.FormatInt(meal.ID, 10) + ", '" + meal.Name + "')"} }
				>
					Edit
				</button>
				<button
					class="btn btn-xs btn-error"
					hx-delete={ "/meals/" + strconv.FormatInt(meal.ID, 10) }
					hx-target={ "#meal-" + strconv.FormatInt(meal.ID, 10) }
					hx-swap="outerHTML swap:300ms"
					hx-confirm="Are you sure you want to delete this meal?"
				>
					Delete
				</button>
			</div>
		</td>
	</tr>
}
