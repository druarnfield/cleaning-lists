package auth

import (
	"github.com/druarnfield/cleaning-scheduler/internal/auth"
	"github.com/druarnfield/cleaning-scheduler/internal/templates/layout"
)

templ ResetPasswordPage(user *auth.User, success bool, errorMsg string) {
	@layout.Base("Reset Password", user) {
		<div class="flex justify-center items-center min-h-[60vh]">
			<div class="card w-96 bg-base-100 shadow-xl">
				<div class="card-body">
					<h2 class="card-title text-2xl mb-4">Reset Password</h2>
					if success {
						<div class="alert alert-success mb-4">
							<span>Password successfully reset!</span>
						</div>
					}
					if errorMsg != "" {
						<div class="alert alert-error mb-4">
							<span>{ errorMsg }</span>
						</div>
					}
					<form method="POST" action="/reset-password">
						<div class="form-control mb-4">
							<label class="label">
								<span class="label-text">Reset Password For</span>
							</label>
							<select name="target_user" class="select select-bordered" required>
								<option value="">Choose...</option>
								if user.Username == "dru" {
									<option value="josie">Josie</option>
								} else {
									<option value="dru">Dru</option>
								}
							</select>
						</div>
						<div class="form-control mb-6">
							<label class="label">
								<span class="label-text">New Password</span>
							</label>
							<input type="password" name="new_password" class="input input-bordered" required minlength="6"/>
						</div>
						<button type="submit" class="btn btn-primary w-full">Reset Password</button>
					</form>
				</div>
			</div>
		</div>
	}
}